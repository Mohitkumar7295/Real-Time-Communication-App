# MeetApp Environment Variables Template
# Copy this file to .env and replace placeholders with your actual configuration.
# Never commit .env or real credentials to source control.

# Database Configuration (Supabase PostgreSQL Session Pooler)
DB_URL=jdbc:postgresql://aws-1-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_USER=postgres.YOUR_PROJECT_REF
DB_PASSWORD=your_database_password

# Authentication & Security Secrets
JWT_SECRET=your_jwt_secret_min_32_characters_long
OTP_PEPPER=your_otp_pepper_secret_value
APP_ALLOWED_ORIGIN=http://localhost:8080

# Email Delivery (Log in Dev, Resend in Prod)
EMAIL_PROVIDER=log
RESEND_API_KEY=re_your_resend_api_key
MAIL_FROM=onboarding@resend.dev
OTP_EXPIRY_MINUTES=5

# Application Storage & Room Limits
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10
MAX_ROOM_PARTICIPANTS=5

# Optional WebRTC NAT Traversal (STUN / TURN)
STUN_URLS=stun:stun.l.google.com:19302
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
